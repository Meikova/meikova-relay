# Meikova Relay Server Configuration

# Server Port (Default: 8080)
PORT=8080

# ==============================================================================
# SQLite Dual Adapter: Turso Cloud or Local SQLite WAL
# ==============================================================================
# Option 1: Turso Cloud SQLite (Production & Multi-Instance High-Availability)
# When both TURSO_DATABASE_URL and TURSO_AUTH_TOKEN are provided, relay-server
# connects directly to Turso Cloud via @libsql/client.
TURSO_DATABASE_URL=libsql://meikova-relay-m3ik18dp.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Option 2: Local SQLite WAL Fallback (Zero-Config Offline Mode)
# If TURSO_DATABASE_URL is not set, relay-server automatically falls back to a
# high-performance local SQLite database file in WAL mode.
# DATA_DIR=./
# DB_PATH=./meikova_relay.db

# ==============================================================================
# Google OAuth 2.0 Credentials (Optional)
# ==============================================================================
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_CLIENT_SECRET_PATH=../data/client_secret.json

# Environment mode
NODE_ENV=production
